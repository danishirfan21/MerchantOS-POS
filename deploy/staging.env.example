# Paths only. Generate private values with init-local.py; never put passwords here.
STAGING_DIR=/absolute/private/merchantos-local-staging
STAGING_UID=1000
ADMIN_CONTEXT=/absolute/source/MerchantOS-Admin
COMPOSE_PROJECT_NAME=merchantos_staging
SEED_DEMO=false
# For restore only: path to offline private backup recovery key.
# BACKUP_PRIVATE_KEY_FILE=/offline/private/backup_key.pem
