FROM postgres:17-alpine@sha256:266d3c257594e195b309ae9d1805e54c788f1d7b375f56bf6c367aac6c917e7b
RUN apk upgrade --no-cache && apk add --no-cache python3 py3-pip openssl && rm -f /usr/local/bin/gosu
COPY deploy/operations/requirements.lock /ops/operations/requirements.lock
RUN python3 -m venv /opt/operations && /opt/operations/bin/pip install --no-cache-dir --require-hashes -r /ops/operations/requirements.lock
ENV PATH="/opt/operations/bin:$PATH"
COPY deploy/operations/ /ops/operations/
COPY deploy/*.py /ops/
COPY db/init/ /schema/
COPY db/migrations/ /migrations/
WORKDIR /ops
ENTRYPOINT ["python3"]
CMD ["/ops/migrate-entry.py"]
