# Installer dependencies remain in a disposable build stage, never in the operator runtime.
FROM postgres:17-alpine@sha256:266d3c257594e195b309ae9d1805e54c788f1d7b375f56bf6c367aac6c917e7b AS python-build
RUN apk upgrade --no-cache && apk add --no-cache python3 py3-pip
COPY deploy/operations/requirements.lock /tmp/requirements.lock
RUN python3 -m venv /opt/operations && /opt/operations/bin/pip install --no-cache-dir --require-hashes -r /tmp/requirements.lock \
 && rm -rf /opt/operations/lib/python*/site-packages/pip* /opt/operations/lib/python*/site-packages/setuptools* /opt/operations/lib/python*/site-packages/pkg_resources*
FROM postgres:17-alpine@sha256:266d3c257594e195b309ae9d1805e54c788f1d7b375f56bf6c367aac6c917e7b
RUN apk upgrade --no-cache && apk add --no-cache python3 openssl && rm -f /usr/local/bin/gosu
COPY --from=python-build /opt/operations /opt/operations
ENV PATH="/opt/operations/bin:$PATH" PYTHONDONTWRITEBYTECODE=1
COPY deploy/operations/ /ops/operations/
RUN rm -f /ops/operations/fixture.py /ops/operations/verify_operations.py /ops/operations/staging_monitor.py /ops/operations/install-ci.sh /ops/operations/requirements-ci.lock
COPY deploy/*.py /ops/
COPY db/init/ /schema/
COPY db/migrations/ /migrations/
WORKDIR /ops
ENTRYPOINT ["python3"]
CMD ["/ops/migrate-entry.py"]
