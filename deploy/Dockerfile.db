# Same supported PostgreSQL image/entrypoint; rebuild its upstream gosu helper with patched Go.
FROM golang:1.27.3-alpine@sha256:d200d2dd76b03a99b52651fd1325aff7dcd35422c35c01bac56571b0507f3deb AS gosu
ENV CGO_ENABLED=0 GOTOOLCHAIN=local GOMAXPROCS=2 GOFLAGS=-p=2
# Upstream release tag is "1.19", not a Go semver tag. Build its exact source.
RUN apk add --no-cache git
WORKDIR /src/gosu
RUN git init . \
 && git remote add origin https://github.com/tianon/gosu.git \
 && git fetch --depth=1 origin 6456aaa0f3c854d199d0f037f068eb97515b7513 \
 && git checkout --detach FETCH_HEAD \
 && test "$(git rev-parse HEAD)" = 6456aaa0f3c854d199d0f037f068eb97515b7513 \
 && go mod download \
 && go mod verify \
 && go build -mod=readonly -trimpath -buildvcs=true -ldflags='-d -w' -o /go/bin/gosu . \
 && /go/bin/gosu --version \
 && test "$(/go/bin/gosu nobody id -u)" != 0
FROM postgres:17-alpine@sha256:266d3c257594e195b309ae9d1805e54c788f1d7b375f56bf6c367aac6c917e7b
RUN apk upgrade --no-cache
COPY --from=gosu /go/bin/gosu /usr/local/bin/gosu
